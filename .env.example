# Postgres connection string (free: neon.tech, or Vercel > Storage > Neon)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# Public URL of the site (used for Stripe redirects)
APP_URL="http://localhost:3000"
# Stripe (see docs/STRIPE.md). Use sk_test_ keys until you go live.
# Empty on local dev = free "test mode" top-ups. Empty on the live site = purchases switched off.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Set to 1 only if you really want free purchases on a deployed site (e.g. a preview)
ALLOW_FREE_TEST_PAYMENTS=""
# Random string used to hash visitor IPs for click de-duplication
VISITOR_SALT="change-me"
# Shown on the Contact, Terms, Privacy and Refund pages. Needed before launch (payment providers check it).
CONTACT_EMAIL=""
# Who runs the site and where, for the legal pages (e.g. "Ahmet T." and "Türkiye")
OPERATOR_NAME=""
OPERATOR_COUNTRY=""
# Name of the payment company shown on the legal pages (default "Stripe")
PAYMENT_PROVIDER=""
# Trailer video uploads (Vercel > Storage > Blob adds this automatically). Empty = YouTube links only.
BLOB_READ_WRITE_TOKEN=""
# Emails like "forgot password" links, sent with Resend (resend.com). Empty = reset links only printed in the server log.
RESEND_API_KEY=""
# Sender shown in those emails. The domain must be verified in Resend.
EMAIL_FROM="Spawnswap <noreply@spawnswap.com>"
# "Sign in with Roblox" (see docs/ROBLOX_OAUTH.md). Empty = users link with a code in their Roblox About.
ROBLOX_OAUTH_CLIENT_ID=""
ROBLOX_OAUTH_CLIENT_SECRET=""
# Set to 1 after Roblox approves the app. Before that the button only shows at /dashboard/roblox?oauth=1 (10 test users max).
ROBLOX_OAUTH_PUBLIC=""

# Trailer check: Claude looks at a few frames of every new trailer (kid safety, real Roblox gameplay, quality).
# Without it only the technical checks run (16:9, 720p+, 5-35 s) and everything that passes them goes live.
ANTHROPIC_API_KEY=""
# Who can open /admin/trailers (comma separated). Defaults to the site owner's email.
ADMIN_EMAILS=""
# Optional: if set, /api/cron/presence needs ?key=<this>
CRON_SECRET=
