# Postgres connection string (free: neon.tech, or Vercel > Storage > Neon)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# Public URL of the site (used for Stripe redirects)
APP_URL="http://localhost:3000"
# Leave empty to use "test mode" top-ups (credits added instantly, no real money)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Random string used to hash visitor IPs for click de-duplication
VISITOR_SALT="change-me"
# Optional: shown at the bottom of the Terms and Privacy pages
CONTACT_EMAIL=""
