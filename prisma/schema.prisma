generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  passwordHash     String
  displayName      String
  // 1 credit = 1 verified player (someone who played your game 10+ minutes and left feedback)
  credits          Int        @default(0)
  robloxUserId     String?    @unique
  robloxUsername   String?
  robloxVerifyCode String?
  robloxVerified   Boolean    @default(false)
  createdAt        DateTime   @default(now())
  sessions         Session[]
  games            Game[]
  payments         Payment[]
  tasks            PlayTask[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Game {
  id             String     @id @default(cuid())
  ownerId        String
  placeId        String     @unique
  universeId     String?
  name           String
  description    String     @default("")
  iconUrl        String?
  // YouTube link or direct .mp4/.webm URL shown as a muted preview on the homepage
  trailerUrl     String?
  playing        Int        @default(0)
  visits         Int        @default(0)
  genre          String     @default("All")
  // Shared secret the in-game tracker script sends with every heartbeat
  secret         String     @unique @default(cuid())
  scriptLastSeen DateTime?
  featuredUntil  DateTime?
  createdAt      DateTime   @default(now())
  owner          User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  campaigns      Campaign[]
  tasks          PlayTask[]
  visitsLog      Visit[]
  payments       Payment[]
}

// A dev spends credits to get N verified players. Credits are reserved up front.
model Campaign {
  id            String     @id @default(cuid())
  gameId        String
  targetPlayers Int
  delivered     Int        @default(0)
  status        String     @default("ACTIVE") // ACTIVE | PAUSED | DONE | CANCELLED
  createdAt     DateTime   @default(now())
  game          Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tasks         PlayTask[]
}

// One player trying one game. Heartbeats from the game's script add playtime.
model PlayTask {
  id            String    @id @default(cuid())
  gameId        String
  campaignId    String
  playerId      String
  robloxUserId  String
  status        String    @default("PENDING") // PENDING | PLAYED | COMPLETED | EXPIRED
  playedSeconds Int       @default(0)
  lastPingAt    DateTime?
  rating        Int?
  feedback      String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  game          Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  player        User      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([gameId, playerId])
  @@index([gameId, robloxUserId, status])
}

// Clicks from the public discovery page (featured + new games)
model Visit {
  id          String   @id @default(cuid())
  gameId      String
  featured    Boolean  @default(false)
  visitorHash String
  day         String
  createdAt   DateTime @default(now())
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, day])
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  kind        String // CREDITS | FEATURED
  amountCents Int
  credits     Int      @default(0)
  gameId      String?
  days        Int      @default(0)
  provider    String // stripe | test
  externalId  String?  @unique
  status      String   @default("PENDING") // PENDING | PAID
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)
}
