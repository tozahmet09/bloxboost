generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  passwordHash     String
  displayName      String
  // 1 credit = 1 verified player (someone who played your game 10+ minutes and left feedback)
  credits          Int        @default(0)
  robloxUserId     String?    @unique
  robloxUsername   String?
  robloxVerifyCode String?
  robloxVerified   Boolean    @default(false)
  // When the linked Roblox account was made. Brand-new Roblox accounts don't earn invite bonuses (stops alt farming).
  robloxCreatedAt  DateTime?
  createdAt        DateTime   @default(now())
  // Invite link: /signup?ref=<referralCode>. The inviter is paid once the new user finishes a first verified play.
  // Not @unique so `prisma db push` on deploy can add it without a data-loss prompt; codes are random and checked before use.
  referralCode     String?
  referredById     String?
  referralPaid     Boolean    @default(false)
  sessions         Session[]
  passwordResets   PasswordReset[]
  games            Game[]
  payments         Payment[]
  tasks            PlayTask[]
  likes            Like[]
  comments         Comment[]
  commentLikes     CommentLike[]

  @@index([referralCode])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// "Forgot password" links. Only a hash of the token is stored, so a database leak can't be used to reset passwords.
model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Game {
  id             String     @id @default(cuid())
  ownerId        String
  placeId        String     @unique
  universeId     String?
  name           String
  description    String     @default("")
  iconUrl        String?
  // YouTube link or direct .mp4/.webm URL shown as a muted preview on the homepage
  trailerUrl     String?
  // Trailer check (see src/lib/trailerCheck.ts). trailerUrl is always the approved, public trailer.
  // A new trailer the AI wasn't sure about waits in pendingTrailerUrl until an admin decides.
  pendingTrailerUrl String?
  trailerStatus     String? // null = nothing to say | "REVIEW" = waiting for an admin | "REJECTED"
  trailerNote       String? // reason shown to the game's owner (and AI notes for the admin)
  trailerCheckedAt  DateTime? // when the live trailer passed the check; null = uploaded before checks existed
  playing        Int        @default(0)
  visits         Int        @default(0)
  genre          String     @default("All")
  // Shared secret the in-game tracker script sends with every heartbeat
  secret         String     @unique @default(cuid())
  scriptLastSeen DateTime?
  featuredUntil  DateTime?
  // Release date set by the dev. While it's in the future the game shows in "Coming soon" instead of "All games".
  releaseAt      DateTime?
  likeCount      Int        @default(0)
  createdAt      DateTime   @default(now())
  owner          User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  campaigns      Campaign[]
  tasks          PlayTask[]
  visitsLog      Visit[]
  payments       Payment[]
  likes          Like[]
  comments       Comment[]
}

// A dev spends credits to get N verified players. Credits are reserved up front.
model Campaign {
  id            String     @id @default(cuid())
  gameId        String
  targetPlayers Int
  delivered     Int        @default(0)
  status        String     @default("ACTIVE") // ACTIVE | PAUSED | DONE | CANCELLED
  createdAt     DateTime   @default(now())
  game          Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tasks         PlayTask[]
}

// One player trying one game. Heartbeats from the game's script add playtime.
model PlayTask {
  id            String    @id @default(cuid())
  gameId        String
  campaignId    String
  playerId      String
  robloxUserId  String
  status        String    @default("PENDING") // PENDING | PLAYED | COMPLETED | EXPIRED
  playedSeconds Int       @default(0)
  lastPingAt    DateTime?
  // How the playtime was confirmed: SCRIPT (in-game tracker, strongest) or PRESENCE (Roblox online status, no script needed)
  verifiedBy    String?
  // Last time we asked Roblox's presence API about this player (presence mode only)
  presenceCheckedAt DateTime?
  rating        Int?
  feedback      String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  game          Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  player        User      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([gameId, playerId])
  @@index([gameId, robloxUserId, status])
}

// Clicks from the public discovery page (featured + new games)
model Visit {
  id          String   @id @default(cuid())
  gameId      String
  featured    Boolean  @default(false)
  visitorHash String
  day         String
  createdAt   DateTime @default(now())
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, day])
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  kind        String // CREDITS | FEATURED
  amountCents Int
  credits     Int      @default(0)
  gameId      String?
  days        Int      @default(0)
  provider    String // stripe | test
  // Stripe Checkout Session id
  externalId  String?  @unique
  // Stripe PaymentIntent id, used to match refunds and disputes
  paymentIntentId String? @unique
  status      String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED | DISPUTED
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)
}

// Community: anyone with an account can like a game and comment on it.
model Like {
  userId    String
  gameId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
  @@index([gameId, createdAt])
}

model Comment {
  id        String        @id @default(cuid())
  gameId    String
  userId    String
  body      String
  likeCount Int           @default(0)
  createdAt DateTime      @default(now())
  game      Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     CommentLike[]

  @@index([gameId, createdAt])
  @@index([userId])
}

model CommentLike {
  userId    String
  commentId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
}

// One row per attempt for simple rate limits (login, signup, Roblox lookups). Old rows are cleaned up as we go.
model RateHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
